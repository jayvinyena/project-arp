{
  "name": "arp-next",
  "version": "0.0.0",
  "private": true,
  "description": "ARP(아트 리소스 플래너) 새 설계 — 로컬 우선 브라우저 앱(PWA). 6단계(확장) 완료",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json",
    "samples": "node tools/build-samples.mjs",
    "validate": "node tools/validate.mjs",
    "rules-doc": "node tools/gen-rules-doc.mjs",
    "scale": "node tools/gen-scale.mjs",
    "plan": "node tools/plan.mjs",
    "build:web": "vite build",
    "bench:browser": "node tools/bench-browser.mjs",
    "dev": "vite",
    "capture": "node tools/capture.mjs",
    "e2e": "node tools/e2e-all.mjs",
    "compare-legacy": "node tools/compare-legacy.mjs",
    "review-data": "node tools/data-review.mjs",
    "build": "node tools/build-samples.mjs && vite build"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "preact": "10.29.8",
    "pretendard": "1.3.9"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
